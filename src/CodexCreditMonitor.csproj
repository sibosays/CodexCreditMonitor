<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CodexCreditMonitor</AssemblyName>
    <RootNamespace>CodexCreditMonitor</RootNamespace>
    <ApplicationIcon>Assets\codex-credit-monitor.ico</ApplicationIcon>
    <Version>2.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="WhatsNew.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
