<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CodexCreditMonitor</AssemblyName>
    <RootNamespace>CodexCreditMonitor</RootNamespace>
    <ApplicationIcon>Assets\codex-credit-monitor.ico</ApplicationIcon>
    <Version>2.2.0</Version>
    <!-- Ship a self-contained Windows app: no separate .NET Desktop Runtime is required. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="WhatsNew.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
